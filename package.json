{
  "name": "rin",
  "version": "1.0.0",
  "workspaces": [
    "server",
    "client"
  ],
  "private": true,
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "turbo dev",
    "check": "turbo check",
    "cf-deploy": "bun server/migrator.ts",
    "b": "turbo build",
    "t": "turbo t",
    "g": "turbo run g",
    "m": "turbo run db:mig",
    "clean": "rm -rf dist node_modules client/node_modules server/node_modules",
    "format:check": "turbo format:check",
    "format:write": "turbo format:write",
    "docker": "docker build . -t thankrain/rin:latest && docker push thankrain/rin:latest"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "turbo": "^1.13.3",
    "vitest": "1.3.0",
    "strip-indent": "^4.0.0",
    "wrangler": "^3.57.1"
  },
  "dependencies": {}
}
